# Copy this file to .env and fill in the real values.
# .env is ignored by git and must never be committed.
#
# On Supabase these are set as "Edge Function secrets", not in this file.
# This file is only for running things on your own machine.

TELEGRAM_BOT_TOKEN=paste-the-token-botfather-gave-you

# Optional. Only used if app_settings has no telegram_chat_id row.
TELEGRAM_CHAT_ID=
